{
  "name": "void-blaster",
  "version": "1.1.1",
  "private": true,
  "description": "Neon space survivor for iPhone and Android",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "ios": "node scripts/build.mjs && npx cap sync ios",
    "open": "npx cap open ios",
    "build:web": "node scripts/build-web.mjs",
    "serve": "npx http-server -p 8080 -c-1 .",
    "update": "node scripts/review.mjs",
    "bump": "node scripts/bump.mjs",
    "build:release": "node scripts/build.mjs --release",
    "ios:release": "node scripts/build.mjs --release && npx cap sync ios",
    "review": "node scripts/review.mjs",
    "play": "node scripts/build.mjs && npx cap sync ios && node scripts/sim.mjs",
    "play:test": "node scripts/testapp.mjs sim",
    "phone:test": "node scripts/testapp.mjs phone",
    "release": "node scripts/release.mjs",
    "android": "node scripts/build.mjs && npx cap sync android",
    "android:open": "node scripts/build.mjs && npx cap sync android && npx cap open android",
    "android:play": "node scripts/android.mjs play",
    "android:test": "node scripts/android.mjs test",
    "proto2": "python3 proto2/make-assets.py && node proto2/build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2",
    "pixi.js": "^8.22.0"
  }
}
